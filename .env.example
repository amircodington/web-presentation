# ─────────────────────────────────────────────────────────
#  SINGLE SOURCE OF TRUTH
#  This file is COMMITTED and contains NO SECRETS.
#  Secrets belong in .env.secrets (git-ignored).
#  See docs/operations/02-versioning-and-releases.md
# ─────────────────────────────────────────────────────────

# ─── Version ─────────────────────────────────────────────
# Managed by `npm run release`. Never hand-edit.
APP_VERSION=0.0.0
APP_NAME=wealth-club-kiosk
APP_BUILD_DATE=

# ─── Docker ──────────────────────────────────────────────
DOCKER_IMAGE=wealth-club/kiosk
DOCKER_REGISTRY=
DEV_PORT=3000
NODE_VERSION=22-bookworm-slim
NGINX_VERSION=1.27-alpine

# ─── Deployment ──────────────────────────────────────────
# The public port nginx is published on. Everything reaches the kiosk here.
PROD_PORT=3002
# Host interface the published port binds to. 0.0.0.0 means "every interface
# this machine has", so the same value works on the server, on the booth
# mini-PC, and on a laptop — no per-machine edit. Narrow it to a single
# address only to deliberately restrict who can reach the port.
BIND_IP=0.0.0.0
# Public address of the server, used for nginx `server_name` and printed by
# the deploy script. `_` accepts any Host header.
SERVER_HOST=89.45.89.150
# Port the Next.js container listens on inside the compose network. Never
# published to the host in production — nginx is the only way in.
APP_INTERNAL_PORT=3000

# ─── Kiosk behaviour ─────────────────────────────────────
KIOSK_IDLE_TIMEOUT_MS=75000
KIOSK_SUCCESS_RESET_MS=9000
KIOSK_QR_RESET_MS=25000
KIOSK_GESTURE_RECENTER_MS=6000
KIOSK_FESTIVAL_OFFER_ENABLED=true
KIOSK_SCHEDULE_TICK_MS=20000
KIOSK_ATTRACT_LOOP_MS=18000
KIOSK_LEAD_CAPTURE_MODE=qr-first

# ─── Presentation engine ─────────────────────────────────
ENGINE_DESIGN_WIDTH=1920
ENGINE_DESIGN_HEIGHT=1080
ENGINE_MIN_ZOOM=0.4
ENGINE_MAX_ZOOM=2.5
ENGINE_STAGE_INSET_PX=26
ENGINE_DEFAULT_TRANSITION=glide

# ─── Lead archive ────────────────────────────────────────
# Where collaboration requests are written. Relative paths resolve against the
# app's working directory, which is what a bare `npm run dev` uses. In a
# container this is overridden with LEADS_VOLUME_PATH below.
LEADS_DATA_DIR=.data/leads
# Mount point of the Docker volume that holds the archive. Compose uses this
# value twice — as the volume target and as the container's LEADS_DATA_DIR —
# so the two can never drift apart.
LEADS_VOLUME_PATH=/data/leads
# Largest accepted submission body. A collaboration request is a few hundred
# bytes; anything near this is someone probing.
LEADS_MAX_BODY_BYTES=8192
# LEADS_ACCESS_TOKEN is the archive link's secret and therefore lives in the
# git-ignored `.env.secrets`. See `.env.secrets.example`.

# ─── Feature flags ───────────────────────────────────────
FEATURE_QUIZ_ENABLED=true
FEATURE_LEAD_FORM_ENABLED=true
FEATURE_ADMIN_OVERLAY_ENABLED=true
